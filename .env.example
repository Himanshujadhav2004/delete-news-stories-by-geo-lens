#ENVIRONMENT VARIABLES
# - To use getSmartAccountWalletClient you'll need the private key associated with your Geo account.
# - You can get the private key for your Geo Genesis account using https://www.geobrowser.io/export-wallet.
PK_SW = ""
DEMO_SPACE_ID = "468971287a094b28825023689320b338"

# Judges every candidate pair, and (unless --lens replaces it) sweeps for them.
# Required by 14_dedupe_news_stories.ts except with --detect-only.
ANTHROPIC_API_KEY=


# geo-lens — a local mirror of the Geo graph with per-cache vector indexes.
# Used by `14_dedupe_news_stories.ts --lens` as a candidate source: free, with
# no date window, and semantic rather than word-overlap. It never confirms a
# duplicate; every pair it proposes still faces the judge.
LENS_URL = "https://geo-lens-production-b192.up.railway.app"
LENS_API_KEY = ""
# The cache handle created with POST /caches. Default "news".
LENS_CACHE_HANDLE = "news"
